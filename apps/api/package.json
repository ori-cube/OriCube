{
  "name": "@oricube/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/app.ts",
    "./mocks/*": "./src/mocks/*.ts"
  },
  "scripts": {
    "dev": "tsx watch --tsconfig tsconfig.json src/dev.ts",
    "dev:worker": "wrangler dev",
    "build": "vite build",
    "start": "node dist/index.js",
    "deploy:worker": "wrangler deploy",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@clerk/backend": "^3.24.0",
    "@hono/node-server": "^2.1.5",
    "@hono/zod-validator": "^0.9.1",
    "@oricube/engine": "workspace:*",
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite": "^7.3.5",
    "wrangler": "^4.150.0"
  }
}
