{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oricube",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // 画面のビルド結果（pnpm build:web）。/assets/* は Worker を通さずに静的配信し、
  // それ以外（API・作品ページのOGP・404）は Worker で返す
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/*", "!/assets/*"]
  },
  // 作品の保存先。database_id は `wrangler d1 create oricube` の結果に置き換える
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "oricube",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true }
}
