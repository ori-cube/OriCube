{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oricube",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // 画面のビルド結果（pnpm build:web）。/assets/* は Worker を通さずに静的配信し、
  // それ以外（API・作品ページのOGP・404）は Worker で返す
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/*", "!/assets/*"]
  },
  // 作品の保存先。database_id は `wrangler d1 create oricube` の結果に置き換える
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "oricube",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // サムネイルの保存先。`wrangler r2 bucket create oricube-thumbnails` で作る。
  // 画像は公開バケットにせず Worker（/api/storage/objects/*）から返す
  "r2_buckets": [
    {
      "binding": "THUMBNAILS",
      "bucket_name": "oricube-thumbnails"
    }
  ],
  // 書き込みAPI（投稿・更新・削除など）の回数制限。ログインした人ごとに1分30回（src/rateLimit.ts の WRITE_LIMIT と合わせる）。
  // namespace_id はアカウント内で他の Worker と重ならない数字にする
  "ratelimits": [
    {
      "name": "WRITE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 30, "period": 60 }
    }
  ],
  // 公開前のまま残った作品と、使われていないサムネイルの掃除（src/cleanup.ts）。毎日 03:17 UTC（12:17 JST）
  "triggers": { "crons": ["17 3 * * *"] },
  "observability": { "enabled": true }
}
