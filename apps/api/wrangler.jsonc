{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oricube",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // 画面のビルド結果（pnpm build:web）。/assets/* は Worker を通さずに静的配信し、
  // それ以外（API・作品ページのOGP・404）は Worker で返す
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/*", "!/assets/*"]
  },
  // 作品の保存先。database_id は `wrangler d1 create oricube` の結果に置き換える
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "oricube",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // 書き込みの回数の上限（接続元の IP ごと・1分あたり）。bot は Turnstile で止め、こちらは連続投稿と鍵の総当たりを抑える。
  // namespace_id はアカウント内で重ならない数字にする
  "ratelimits": [
    { "name": "POST_LIMITER", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } },
    { "name": "WRITE_LIMITER", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
