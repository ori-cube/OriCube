{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oricube",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // 画面のビルド結果（pnpm build:web）。/assets/* は Worker を通さずに静的配信し、
  // それ以外（API・作品ページのOGP・404）は Worker で返す
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/*", "!/assets/*"]
  },
  // 作品の保存先。本番の D1（`wrangler d1 create oricube --location apac` で作成済み）
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "oricube",
      "database_id": "77734f82-5292-4a3a-88b0-3e43a6232418",
      "migrations_dir": "migrations"
    }
  ],
  // サムネイルの保存先。`wrangler r2 bucket create oricube-thumbnails` で作る。
  // 画像は公開バケットにせず Worker（/api/storage/objects/*）から返す
  "r2_buckets": [
    {
      "binding": "THUMBNAILS",
      "bucket_name": "oricube-thumbnails"
    }
  ],
  "observability": { "enabled": true }
}
