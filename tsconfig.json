{
  // ルートの設定ファイル・E2E・スクリプトの型検査用。アプリとパッケージはそれぞれの tsconfig.json で検査する
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "types": ["node"]
  },
  "include": ["*.ts", ".storybook/**/*.ts", "e2e/**/*.ts"],
  "exclude": ["node_modules", "apps", "packages"]
}
