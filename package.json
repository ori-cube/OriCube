{
  "name": "origami",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "scripts": {
    "preinstall": "node scripts/check-package-manager.mjs",
    "test:package-manager": "node --test scripts/check-package-manager.test.mjs",
    "test:security": "node --test scripts/dependency-security.test.mjs",
    "dev:web": "pnpm --filter @oricube/web dev",
    "build:web": "pnpm --filter @oricube/web build",
    "dev:api": "pnpm --filter @oricube/api dev",
    "build:app": "pnpm --filter @oricube/web build && pnpm --filter @oricube/api build",
    "start:app": "pnpm --filter @oricube/api start",
    "smoke:app": "node scripts/smoke-app.mjs",
    "smoke:worker": "node scripts/smoke-worker.mjs",
    "dev:worker": "pnpm --filter @oricube/web build && pnpm --filter @oricube/api run dev:worker",
    "deploy:worker": "pnpm --filter @oricube/web build && pnpm --filter @oricube/api run deploy:worker",
    "lint": "eslint --max-warnings=0 apps packages e2e scripts .storybook --ext .ts,.tsx,.mjs",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "test:ui": "vitest --ui",
    "test:storybook": "vitest --config vitest.storybook.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:all": "pnpm test:package-manager && pnpm test:security && pnpm test && pnpm test:storybook",
    "prepare": "husky",
    "storybook": "storybook dev -p 6006 --no-open --host 0.0.0.0",
    "build-storybook": "storybook build"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^4.0.1",
    "@commitlint/cli": "^19.8.1",
    "@oricube/design-system": "workspace:*",
    "@oricube/engine": "workspace:*",
    "@storybook/addon-a11y": "^9.1.20",
    "@storybook/addon-docs": "^9.1.20",
    "@storybook/addon-vitest": "^9.1.20",
    "@storybook/react-vite": "^9.1.20",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "commitizen": "^4.3.2",
    "commitlint-config-gitmoji": "^2.3.1",
    "cz-customizable": "^7.5.4",
    "destyle.css": "^4.0.1",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-storybook": "^9.1.20",
    "husky": "^9.1.7",
    "jsdom": "^20.0.3",
    "playwright": "^1.55.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "^9.1.20",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-customizable"
    },
    "cz-customizable": {
      "config": ".cz-config.cts"
    }
  }
}
