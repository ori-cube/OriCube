# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.pnpm-store/

# use pnpm only — never commit npm/yarn lockfiles
package-lock.json
yarn.lock
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files (can opt-in for commiting if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo

firestore-admin-key.json


# databaseの自動生成ファイル
/database
*storybook.log
storybook-static

# vite
/apps/*/dist

# wrangler
.wrangler/
/.wrangler-dry-run/
